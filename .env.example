SESSION_ID=WHIZ_your_whatsapp_session_here
OWNER_NAME=WHIZ
BOT_NAME=WHIZ-MD
BOT_PHONE_NUMBER= # Optional: Bot's WhatsApp phone number, e.g., 15551234567 (for wa.me link in /invite)
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx
OPENWEATHERMAP_API_KEY= # Optional: Your OpenWeatherMap API key for /weather command. Get from https://openweathermap.org/appid
NEWSAPI_ORG_API_KEY= # Optional: Your NewsAPI.org API key for /news command. Get from https://newsapi.org
PORT=8000
HOST=0.0.0.0
MODE=development

# You can add other configuration variables here
# For example, database connection strings, API endpoints, etc.

# Note:
# - Ensure SESSION_ID starts with "WHIZ_"
# - If not, visit https://whizmdsessions.onrender.com to get a valid one.
# - Keep your actual .env file (copied from this example) out of version control.
